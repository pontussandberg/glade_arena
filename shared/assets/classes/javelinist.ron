#![enable(unwrap_variant_newtypes)]
// The Javelinist (field reference: README.md).
(
    id: "javelinist",
    name: "Jav",
    role: "Marksman",
    blurb: "Hurls heavy javelins. The farther they fly, the harder they hit.",
    max_hp: 95,
    move_speed: 4.25,
    attack: (
        damage: 16,
        attack_ticks: 43,
        windup: 0.442,
        kind: Projectile(speed: 60.0, radius: 0.25, range: 15.0, far_scale: Some(2.25), falls: true),
        // Javelins go right through monsters (not players), skewering a line of them.
        pierces: true,
    ),
    // Q: a shove with the spear's haft, from the hip. Its attack_ticks are its whole cooldown,
    // a span of its own: attack speed quickens each style from its own base.
    secondary: Some(
        name: "Spear Shove",
        description: "Drive the spear forward from the hip: enemies in front take a little damage, are shoved back and briefly slowed.",
        attack: (
            damage: 5,
            attack_ticks: 43,
            windup: 0.3,
            kind: Melee(range: 2.4, width: 1.4),
            chill: (slow: 0.35, slow_ticks: 24),
        ),
        knockback: 2.0,
    ),
    abilities: [
        (
            name: "Deadeye",
            description: "Your next auto-attack gains +{ability_attack_speed} attack speed and will critically strike. Press again to call it off. The cooldown starts once it's thrown.",
            cooldown_ticks: 480,
            // Off the global cooldown: priming (or calling it off) never holds up the next ability.
            global_cooldown: false,
            kind: Prime(attack_speed: 0.5),
        ),
    ],
    passive: Some(
        name: "Long Shot",
        description: "Auto-attacks deal more damage the farther they fly, up to {far_scale} at full range, and pierce through monsters.",
    ),
    // A touch smaller than his figure, so he takes less of the screen beside the crosshair.
    look: Some(figure: "javelinist", size: 0.9),
    crit: (chance: 0.1),
)
