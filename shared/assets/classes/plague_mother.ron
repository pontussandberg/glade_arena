// births bloaters as she goes. Rages when she is nearly done.
(
    id: "plague_mother",
    name: "The Plague Mother",
    role: "Boss",
    blurb: "Every plague in the wilds came from somewhere.",
    playable: false,
    max_hp: 3400,
    move_speed: 2.2,
    attack: (
        damage: 34,
        attack_ticks: 52,
        windup: 0.45,
        kind: Melee(range: 3.2, width: 1.0),
    ),
    abilities: [
        (
            name: "Rot Wave",
            description: "Everyone within {ability_reach} takes {ability_damage} damage and is slowed.",
            cooldown_ticks: 288,
            kind: Nova(radius: 4.5, damage: 20, chill: (slow: 0.5, slow_ticks: 96)),
        ),
    ],
    look: Some(figure: "zombie", size: 2.6, tint: (0.7, 1.15, 0.5)),
    mob: Some(
        brain: Chase,
        tricks: [
