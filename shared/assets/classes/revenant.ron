#![enable(unwrap_variant_newtypes)]
// The Revenant (field reference: README.md).
(
    id: "revenant",
    name: "Revenant",
    role: "Duelist",
    blurb: "A spectral blade that slips between worlds. Gets in close and keeps cutting.",
    max_hp: 140,
    move_speed: 3.7,
    attack: (
        damage: 20,
        attack_ticks: 34,
        windup: 0.35,
        // The glaive comes down flat on the ground: its blade hits a lane starting a way ahead,
        // not at the revenant's feet.
        kind: Melee(range: 3.08, width: 0.5, from: 1.6),
        // The ground it hits tears open for a while; inside it the revenant walks faster.
        rift: Some(ticks: 96, haste: 0.3),
        // Empowered: quicker, the lane starting a little further out and reaching further and wider.
        follow_up: Some(within_ticks: 96, attack_speed: 0.2, reach: 1.5, near: Some(1.25)),
    ),
    abilities: [
        (
            name: "Rift Step",
            description: "Dash toward the cursor, up to {ability_reach}, dealing {ability_damage} damage to each enemy you pass through.",
            cooldown_ticks: 256,
            kind: Dash(distance: 6.0, min_distance: Some(1.0), ticks: 5, damage: 18),
        ),
    ],
    passive: Some(
        name: "Follow Through",
        description: "Your auto-attacks tear the ground open for {rift_time}: inside the tear you move {rift_haste} faster. After landing a hit, your glaive is empowered for {follow_up_time}: your next auto-attack reaches {follow_up_reach} further and wider, with {follow_up_speed} more attack speed and a {crit_empowered} crit chance. An empowered hit renews it.",
    ),
    crit: (empowered: 0.5),
)
