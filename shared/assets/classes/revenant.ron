#![enable(unwrap_variant_newtypes)]
// The Revenant (field reference: README.md).
(
    id: "revenant",
    name: "Revenant",
    role: "Duelist",
    blurb: "A spectral blade that slips between worlds. Gets in close and keeps cutting.",
    max_hp: 140,
    move_speed: 4.25,
    attack: (
        damage: 20,
        attack_ticks: 34,
        windup: 0.35,
        // The glaive comes down flat on the ground: its blade hits a lane starting a way ahead,
        // not at the revenant's feet. The blade grows as it's drawn up, to lie along all of it.
        kind: Melee(range: 4.62, width: 0.75, from: 2.0),
        // The ground it hits tears open for a while; inside it the revenant walks faster.
        // ... and burns its foes standing in it, healing the revenant a share of the burn.
        rift: Some(ticks: 96, haste: 0.3, burn: 4, leech: 0.334),
        // Empowered, the strike knocks up what it hits, briefly: shorter than its own attack, so
        // it can't keep anything in the air by itself. No quicker, and no further.
        follow_up: Some(within_ticks: 320, attack_speed: 0.0, lift_ticks: 10),
    ),
    abilities: [
        (
            name: "Rift Step",
            description: "Dash up to {ability_reach}. Enemies you pass through take {ability_damage} damage.",
            cooldown_ticks: 256,
            kind: Dash(distance: 12.0, min_distance: Some(1.0), ticks: 10, damage: 18),
        ),
    ],
    passive: Some(
        name: "Follow Through",
        description: "Auto-attacks tear the ground for {rift_time}: inside it, gain +{rift_haste} move speed; enemies standing in it burn for {rift_burn} every 0.5s, and you heal {rift_leech} of it. On hit, your next auto-attack within {follow_up_time} knocks enemies up for {follow_up_lift}.",
    ),
)
