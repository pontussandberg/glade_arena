#![enable(unwrap_variant_newtypes)]
// The Shade (field reference: README.md): a fast, frail knife-dancer who lives on crits.
(
    id: "shade",
    name: "Shade",
    role: "Assassin",
    blurb: "Two knives and nowhere to be. Every attack cuts twice, and the first cut into anyone who wasn't watching goes deep.",
    max_hp: 85,
    move_speed: 3.95,
    attack: (
        damage: 6,
        attack_ticks: 22,
        windup: 0.28,
        kind: Melee(range: 1.35, width: 0.9),
        // One knife, then the other, a beat behind.
        twice: Some(5),
    ),
    abilities: [
        (
            name: "Shadowstep",
            description: "Step up to {ability_reach} in a blink. Enemies you pass through take {ability_damage} damage.",
            cooldown_ticks: 224,
            kind: Dash(distance: 6.5, min_distance: Some(1.0), ticks: 5, damage: 10),
        ),
        (
            name: "Marked Knife",
            description: "Your next auto-attack gains +{ability_attack_speed} attack speed and will critically strike. Press again to call it off.",
            cooldown_ticks: 416,
            global_cooldown: false,
            kind: Prime(attack_speed: 0.6),
        ),
    ],
    passive: Some(
        name: "Ambush",
        description: "Every auto-attack cuts twice. The first cut into an enemy you haven't cut in {ambush_time} always crits; the rest crit {crit} of the time.",
    ),
    // Its own figure, slighter than anyone: hard to see is the point.
    look: Some(figure: "shade", size: 0.92, tint: (1.0, 1.0, 1.0)),
    crit: (chance: 0.15, ambush_ticks: 128),
)
