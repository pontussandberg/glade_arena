#![enable(unwrap_variant_newtypes)]
// The Pyre Witch (field reference: README.md): a fire caster whose every bolt splashes.
(
    id: "pyre_witch",
    name: "Pyre Witch",
    role: "Scourge",
    blurb: "Feeds the fire. Every bolt sets its mark alight, and a mark fed enough goes up in a burst that lights the rest.",
    max_hp: 95,
    move_speed: 3.6,
    attack: (
        damage: 12,
        attack_ticks: 34,
        windup: 0.38,
        kind: Projectile(speed: 13.0, radius: 0.3, range: 9.5),
        // Every bolt sets its mark ablaze, a stack more each time; at full stacks it ignites,
        // bursting fire over everyone round it, and starts over.
        burn: Some(damage: 3, ticks: 128, stacks: 3, ignite_radius: 1.8, ignite_share: 1.0),
    ),
    abilities: [
        (
            name: "Firecall",
            description: "Call a meteor down on a spot up to {ability_reach} away. It lands after {ability_fuse}: enemies within {ability_radius} take {ability_damage} damage.",
            cooldown_ticks: 288,
            kind: Strike(range: 9.0, radius: 2.2, damage: 34, fuse_ticks: 24, shell: Meteor),
        ),
        (
            name: "Ring of Cinders",
            description: "The ground ignites: enemies within {ability_reach} take {ability_damage} damage.",
            cooldown_ticks: 256,
            kind: Nova(radius: 3.4, damage: 16),
        ),
    ],
    passive: Some(
        name: "Kindling",
        description: "Bolts set their target ablaze for {burn_time}: {burn_damage} damage every 0.5s per stack, a stack more per bolt. At {burn_stacks} stacks it ignites: enemies within {ignite_radius} of it take {ignite_share} of a bolt's damage, and the fire goes out.",
    ),
    // Her own figure; only the bolts borrow a look (fire).
    look: Some(figure: "pyre_witch", size: 1.0, tint: (1.0, 1.0, 1.0), bolts: Some(Fire)),
    crit: (chance: 0.1),
)
