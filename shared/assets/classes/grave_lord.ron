    id: "grave_lord",
    name: "The Grave Lord",
    role: "Boss",
    blurb: "The first revenant. The last thing you will see.",
    playable: false,
    max_hp: 2200,
    move_speed: 3.3,
    attack: (
        damage: 32,
        attack_ticks: 48,
        windup: 0.42,
