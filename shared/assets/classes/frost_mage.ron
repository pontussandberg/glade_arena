#![enable(unwrap_variant_newtypes)]
// The Frost Mage (field reference: README.md).
(
    id: "frost_mage",
    name: "Frost Mage",
    role: "Controller",
    blurb: "Bends the cold. Its frostbolts shatter into bursts of ice that slow whole packs, its nova freezes, and it always crits the frozen.",
    max_hp: 100,
    move_speed: 4.25,
    attack: (
        damage: 11,
        attack_ticks: 36,
        windup: 0.32,
        // No range: a frostbolt flies on until it meets something.
        kind: Projectile(speed: 17.0, radius: 0.28),
        chill: (slow: 0.4, slow_ticks: 64),
        // A frostbolt shatters where it hits, or where it ends (a wall, the ground): the cold bursts
        // out over everyone round its mark.
        burst: Some(radius: 1.8, share: 0.7),
    ),
    // Q: the stave's heel slammed into the ground just ahead: a frostbolt's hit over a circle
    // six times a bolt's size, where the heel lands. Three times the bolt's timer; attack speed
    // quickens both from their own base.
    secondary: Some(
        name: "Stave Slam",
        description: "Slam the stave's heel into the ground: the cold bursts out where it lands, a frostbolt's damage and slow over everyone near it.",
        attack: (
            damage: 11,
            attack_ticks: 108,
            windup: 0.12,
            kind: Slam(radius: 1.68, reach: 0.8),
            chill: (slow: 0.4, slow_ticks: 64),
        ),
        blast: Some(Frost),
    ),
    abilities: [
        (
            name: "Frost Nova",
            description: "Enemies within {ability_reach} take {ability_damage} damage and are frozen for {ability_root}.",
            cooldown_ticks: 224,
            kind: Nova(radius: 8.75, damage: 6, chill: (root_ticks: 80)),
        ),
    ],
    passive: Some(
        name: "Shatter",
        description: "Frostbolts shatter where they hit or land: enemies within {burst_radius} take {burst_share} of the damage. Everyone they hit is slowed by {attack_slow} for {attack_slow_time}. Against frozen enemies, gain {crit_vs_frozen} crit chance.",
    ),
    crit: (vs_frozen: 1.0),
)
