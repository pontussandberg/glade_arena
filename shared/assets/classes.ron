// The playable classes. Edit freely: everything gameplay-related about a class lives here.
// Server and client both compile this file in, and its hash is part of the protocol id, so a
// client built from different numbers is refused at connect instead of mispredicting.
//
// Units: meters, meters per second, ticks (64 per second), degrees.
//   id            stable key (also picks the class's look in the client)
//   max_hp        health at spawn and respawn
//   move_speed    walking speed
//   attack        the left-click auto-attack, aimed at the cursor (skillshot)
//     damage, cooldown_ticks (time between attacks; 64 = one per second)
//     windup_ticks  from click to the attack going off; you stand still with your aim locked
//                   meanwhile (see the README)
//     kind: Melee(range, arc_degrees)       hits everyone in a cone in front of you
//           Projectile(speed, radius, range) flies straight, stops at walls/rocks/trees;
//             optional far_damage: damage after flying the full range, scaling linearly from
//             `damage` (point blank) by how far the shot flew
//   ability       the Q ability, aimed at the cursor: name, description, cooldown_ticks, and
//     kind: Projectile(speed, radius, range, damage)  thrown instantly: no windup, no root
//           Dash(distance, ticks, damage)  dash toward the aim over `ticks`, through fighters,
//             cutting each one crossed for `damage`; stops at walls. With resets_attack, landing
//             a hit readies the auto-attack at once.
[
    (
        id: "javelinist",
        name: "Javelinist",
        role: "Hunter",
        blurb: "Hurls heavy javelins. The farther they fly, the harder they hit.",
        max_hp: 95,
        move_speed: 5.4,
        attack: (
            damage: 16,
            cooldown_ticks: 48,
            windup_ticks: 22,
            kind: Projectile(speed: 15.0, radius: 0.25, range: 15.0, far_damage: Some(36)),
        ),
        ability: (
            name: "Spirit Spear",
            description: "Instantly hurl a fast spectral spear. No windup: throw on the move.",
            cooldown_ticks: 384,
            kind: Projectile(speed: 32.0, radius: 0.2, range: 13.0, damage: 22),
        ),
    ),
    (
        id: "revenant",
        name: "Revenant",
        role: "Duelist",
        blurb: "A spectral blade that slips between worlds. Gets in close and keeps cutting.",
        max_hp: 140,
        move_speed: 6.0,
        attack: (
            damage: 20,
            cooldown_ticks: 40,
            windup_ticks: 8,
            kind: Melee(range: 1.8, arc_degrees: 120.0),
        ),
        ability: (
            name: "Rift Step",
            description: "Dash through enemies, cutting each one. A hit readies your blade at once.",
            cooldown_ticks: 320,
            kind: Dash(distance: 6.0, ticks: 10, damage: 18, resets_attack: true),
        ),
    ),
]
