// The playable classes. Edit freely: everything gameplay-related about a class lives here.
// Server and client both compile this file in, and its hash is part of the protocol id, so a
// client built from different numbers is refused at connect instead of mispredicting.
// Their order here is the order everywhere: the class picker and its number keys, the default
// pick, and the order target dummies come in.
//
// Units: meters, meters per second, ticks (32 per second), degrees.
//   id            stable key (also picks the class's look in the client)
//   max_hp        health at spawn and respawn
//   move_speed    walking speed
//   attack        the left-click auto-attack, aimed at the cursor (skillshot)
//     damage
//     windup_ticks  from click to the attack going off, the whole attack (32 = one per second):
//                   the next may start the tick it goes off. You stand still with your aim
//                   locked meanwhile (see the README): holding fire keeps you planted, to move
//                   you stop firing
//     kind: Melee(range, width)             a thrust: hits everyone whose body a straight lane
//             `width` wide reaches, out to `range` from your center
//           Projectile(speed, radius, range) flies straight, stops at walls/rocks/trees;
//             optional far_scale: damage after flying the full range, as a multiple of `damage`
//             (point blank), scaling linearly by how far the shot flew (2.0 = double at full range)
//     chill (optional): crowd control each hit applies on top of its damage:
//       (slow: fraction of speed taken away, slow_ticks: for how long, root_ticks: frozen in
//       place this long: no walking, no dashing, and a dash in progress stops)
//     follow_up (optional, melee only): landing a hit gives the next attack, if started
//       within `within_ticks`, `attack_speed` more attack speed (0.6 = 60% more attacks per
//       second: the windup divided by 1.6). Only that one attack: a miss loses it, a quick one
//       that lands arms the next
//   ability       the Q ability, aimed at the cursor: name, description, cooldown_ticks, and
//     kind: Projectile(speed, radius, range, damage)  thrown instantly: no windup, no root
//           Dash(distance, ticks, damage)  dash `distance` toward the aim, through fighters,
//             cutting each one crossed for `damage`; stops at walls. Takes `ticks` at normal
//             speed (longer slowed, shorter hasted).
//           Nova(radius, damage, chill)  a burst around you, at once: everyone within `radius`
//             (and not behind a wall) takes `damage` and `chill`
//     global_cooldown (optional, true by default): using it starts the global cooldown (1 s),
//       and it waits for it, like every other ability on it; false opts out
//   passive (optional)  shown to players, nothing more: Some((name, description)). Its effect
//     lives in the numbers it describes (far_scale, chill, crit...).
//
// Descriptions (the passive's and the ability's) can name this class's numbers in braces, filled
// in when shown, so the words follow a retune: {far_scale} (the auto-attack's damage after its full
// range, as a percent of point blank), {attack_slow} / {attack_slow_time} (the auto-attack's slow,
// as a percent / in seconds), {follow_up_time} / {follow_up_speed} (the follow_up's window, in
// seconds / its attack speed, as a percent), {crit}, {crit_vs_frozen}, {crit_multiplier} (as percentages),
// {ability_damage}, {ability_reach} (a thrown ability's range, a dash's distance, a nova's
// radius, in meters), {ability_root} (a nova's root, in seconds). A Q that deals damage must name
// {ability_damage}.
//   crit (optional)  odds (0 to 1) that an auto-attack hit you deal is critical for double damage
//     (a Q never crits): (chance: normally, vs_frozen: against a frozen (rooted) target). None by
//     default.
[
    (
        id: "revenant",
        name: "Revenant",
        role: "Duelist",
        blurb: "A spectral blade that slips between worlds. Gets in close and keeps cutting.",
        max_hp: 140,
        move_speed: 3.7,
        attack: (
            damage: 20,
            windup_ticks: 30,
            kind: Melee(range: 3.75, width: 0.05),
            follow_up: Some((within_ticks: 48, attack_speed: 1.0)),
        ),
        ability: (
            name: "Rift Step",
            description: "Dash forward, dealing {ability_damage} damage to each enemy you pass through.",
            cooldown_ticks: 256,
            kind: Dash(distance: 6.0, ticks: 5, damage: 18),
        ),
        passive: Some((
            name: "Follow Through",
            description: "Landing an auto-attack gives your next one +{follow_up_speed} attack speed, if you swing again within {follow_up_time}. Miss and you lose it.",
        )),
        crit: (chance: 0.1),
    ),
    (
        id: "javelinist",
        name: "Jav",
        role: "Marksman",
        blurb: "Hurls heavy javelins. The farther they fly, the harder they hit.",
        max_hp: 95,
        move_speed: 3.7,
        attack: (
            damage: 16,
            windup_ticks: 24,
            kind: Projectile(speed: 15.0, radius: 0.25, range: 15.0, far_scale: Some(2.25)),
        ),
        ability: (
            name: "Spirit Spear",
            description: "Instantly hurl a fast spectral spear for {ability_damage} damage. No windup: throw on the move.",
            cooldown_ticks: 192,
            kind: Projectile(speed: 32.0, radius: 0.2, range: 13.0, damage: 22),
        ),
        passive: Some((
            name: "Long Shot",
            description: "Your auto-attacks hit harder the farther they fly, up to {far_scale} damage at full range.",
        )),
        crit: (chance: 0.1),
    ),
    (
        id: "frost_mage",
        name: "Frost Mage",
        role: "Controller",
        blurb: "Bends the cold. Little damage, but its frostbolts slow, its nova freezes, and it always crits the frozen.",
        max_hp: 100,
        move_speed: 3.7,
        attack: (
            damage: 8,
            windup_ticks: 22,
            kind: Projectile(speed: 17.0, radius: 0.28, range: 10.0),
            chill: (slow: 0.4, slow_ticks: 64),
        ),
        ability: (
            name: "Frost Nova",
            description: "Instantly deal {ability_damage} damage to everyone within {ability_reach} and freeze them in place for {ability_root}: no walking, no dashing.",
            cooldown_ticks: 224,
            kind: Nova(radius: 3.5, damage: 6, chill: (root_ticks: 80)),
        ),
        passive: Some((
            name: "Shatter",
            description: "Auto-attacks against targets frozen by Frost Nova have a {crit_vs_frozen} crit chance. Auto-attacks also slow on hit, by {attack_slow} for {attack_slow_time}.",
        )),
        crit: (vs_frozen: 1.0),
    ),
]
